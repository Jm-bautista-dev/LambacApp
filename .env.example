# Environment Configuration Template for Lambac Coffee Roastery
# Copy this file to .env or pass through build-time --dart-define parameters

APP_NAME="Lambac Coffee Roastery"
APP_ENV=development # development | staging | production

# API Base URLs
API_BASE_URL_DEV=https://api-dev.lambaccoffee.com/v1
API_BASE_URL_STAGING=https://api-staging.lambaccoffee.com/v1
API_BASE_URL_PROD=https://api.lambaccoffee.com/v1

# Networking Timeouts (milliseconds)
CONNECT_TIMEOUT=15000
RECEIVE_TIMEOUT=15000
SEND_TIMEOUT=15000

# Feature Flags
ENABLE_LOGGING=true
ENABLE_ANALYTICS=false
ENABLE_CHAT=true

# Firebase App Check Configuration
# For Web builds: specify your reCAPTCHA v3 or Enterprise Site Key
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

