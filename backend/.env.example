# ============================================================================
# LAMBAC COFFEE ROASTERY — STANDALONE PAYMONGO BACKEND ENVIRONMENT TEMPLATE
# ============================================================================
# Copy this file to .env for local testing ONLY.
# NEVER commit .env or actual secret values to Git.
# In production/staging (Render Free Tier / Vercel Hobby), configure these keys
# exclusively in the hosting dashboard's Environment Variables settings.

PORT=3000

# 1. Firebase Admin SDK Credentials (from Firebase Console -> Project Settings -> Service Accounts)
# Option A: Full JSON string of the service account key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Option B: Individual service account fields (if not using FIREBASE_SERVICE_ACCOUNT_JSON)
FIREBASE_PROJECT_ID=lambac-coffee-roastery
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# 2. PayMongo Secret Credentials (NEVER expose in Flutter or Git)
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# 3. Redirect Base URL after PayMongo Hosted Checkout
APP_WEB_ORIGIN=https://lambac-coffee-roastery.web.app

# 4. Explicit Comma-Separated CORS Allowlist (Localhost Dev + Production Web Origins)
CORS_ALLOWED_ORIGINS=http://localhost:64076,http://localhost:3000,http://localhost:5000,http://localhost:8080,https://lambac-coffee-roastery.web.app,https://lambac-coffee-roastery.firebaseapp.com
CORS_ALLOW_LOCALHOST=true


